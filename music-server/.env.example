# Frosh Music Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Allowed frontend origins for CORS (comma-separated, e.g. http://localhost:3000,https://froshmusic.vercel.app)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Shared Server-to-Server Secret Key (Any request without x-api-key matching this is returned 403 Forbidden)
# Leave empty for open local dev mode
MUSIC_API_KEY=
