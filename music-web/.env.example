# Frosh Music web app — copy to .env.local and fill in.
# See SUPABASE_AUTH_SETUP.md for where each value comes from.

# Supabase (Auth + invite codes). Find these in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Music server API base used by the browser (public tunnel URL in production).
NEXT_PUBLIC_MUSIC_API_URL=https://music-api.akin.qzz.io

# Music server used by the Next.js /api rewrite (server-side only; e.g. https://music-api.akin.qzz.io in prod).
MUSIC_SERVER_INTERNAL_URL=http://127.0.0.1:4000

# Optional server-to-server secret API key passed via x-api-key to protect your music-server from unauthorized users
MUSIC_API_KEY=
